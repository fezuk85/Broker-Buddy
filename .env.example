# Copy to .env.local for local development, or add these as Environment Variables in the
# Vercel project dashboard (Settings > Environment Variables) for production.

# Optional: URL of a mortgage-broker referral / affiliate programme. When set, a clearly-labelled
# "Advertisement" card linking here appears on every calculator page (rel="sponsored"). When
# unset, nothing is shown. NEXT_PUBLIC_ so it is available in the browser at build time.
NEXT_PUBLIC_BROKER_REFERRAL_URL=
